{
  "cleanUrls": true,
  "functions": {
    "server.js": {
      "includeFiles": "{*.html,styles.css,script.js,favicon.ico,assets/**,images/**,data/**,api/**}"
    }
  },
  "rewrites": [
    { "source": "/about-us", "destination": "/about.html" },
    { "source": "/bulk-solutions", "destination": "/bulk.html" },
    { "source": "/our-stores", "destination": "/stores.html" },
    { "source": "/request-quote", "destination": "/quote.html" },
    { "source": "/privacy-policy", "destination": "/privacy.html" },
    { "source": "/terms-of-use", "destination": "/terms.html" },
    { "source": "/products/:slug", "destination": "/product-detail.html" }
  ]
}
